page{--bg:#f7fbff;--bg-soft:#eef5ff;--panel:hsla(0,0%,100%,.74);--panel-solid:#fff;--line:rgba(7,17,31,.08);--text:#07111f;--muted:#647287;--subtle:#7c899c;--primary:#0084ff;--primary-soft:rgba(0,132,255,.1);--success:#10b981;--success-soft:rgba(16,185,129,.12);--warning:#f59e0b;--warning-soft:rgba(245,158,11,.12);--danger:#ef4444;--danger-soft:rgba(239,68,68,.1);background:linear-gradient(180deg,#fff,#f7fbff);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,Segoe UI,sans-serif}button,image,input,map,text,textarea,view{box-sizing:border-box}button::after{border:none}button{font:inherit;margin:0}image{display:block}