page{background:#f5f7f6;color:#18211f}button,image,input,map,text,textarea,view{box-sizing:border-box}button{background:#fff;border:0;color:#18211f;font-size:28rpx;line-height:1.4;margin:0;padding:0}image{display:block}page{background:#f2f5f4;color:#14221e}button,view[aria-label]{-webkit-tap-highlight-color:rgba(7,193,96,.12)}