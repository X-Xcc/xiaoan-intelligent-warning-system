ottom:0}.detail-topbar text{color:#181c1d;font-size:24rpx;font-weight:900}.detail-back{background:#fff;border:1rpx solid rgba(190,200,202,.7);border-radius:8rpx;color:#00535b;font-size:20rpx;height:40rpx;line-height:40rpx;width:104rpx}.detail-hero{background:#fff;border:1rpx solid rgba(190,200,202,.62);border-radius:12rpx;box-shadow:0 2rpx 8rpx rgba(0,109,119,.05);color:#181c1d;min-height:138rpx;padding:18rpx}.detail-hero.help,.detail-hero.lost,.detail-hero.report,.detail-hero.serviceOrder,.detail-hero.staffOrder{background:#fff}.detail-badge{background:#e7f7f5;border-radius:999rpx;color:#00535b;font-size:18rpx;padding:4rpx 10rpx}.detail-title{color:#181c1d;font-size:34rpx;line-height:1.25;margin-top:12rpx}.detail-subtitle{color:#3e494a;font-size:20rpx;line-height:1.45;margin-top:8rpx}.bay-dashboard,.flow-card,.info-section,.order-summary,.policy-row,.record-card,.resource-card,.simple-row,.soft-map,.staff-note,.status-card{background:#fff;border:1rpx solid rgba(190,200,202,.62);border-radius:12rpx;box-shadow:0 2rpx 8rpx rgba(0,109,119,.05);margin-top:12rpx;padding:16rpx}.status-card{overflow:hidden;position:relative}.status-card::before{background:#006d77;bottom:0;content:"";left:0;position:absolute;top:0;width:4rpx}.status-card.warn::before{background:#e29578}.status-card.danger::before{background:#ba1a1a}.status-card.safe::before{background:#236863}.status-card text:first-child{color:#3e494a;font-size:18rpx}.status-card text:nth-child(2){color:#181c1d;font-size:34rpx;margin-top:6rpx}.status-card text:last-child{color:#3e494a;font-size:20rpx}.soft-map{background:linear-gradient(0deg,hsla(0,0%,100%,.88),hsla(0,0%,100%,.44)),linear-gradient(135deg,#dbe9e7,#f3ead8);display:flex;flex-direction:column;justify-content:flex-end;min-height:160rpx}.flow-card > text:first-child{color:#181c1d;display:block;font-size:24rpx;font-weight:900;margin-bottom:12rpx}.flow-row{gap:12rpx;padding:12rpx 0;position:relative}.flow-row view{flex:1;min-width:0}.flow-dot{background:#e6e9e9;border:1rpx solid #bec8ca;border-radius:50%;height:24rpx;margin-top:0;width:24rpx}.flow-dot.active{background:#006d77;border-color:#006d77}.flow-row view text:first-child{color:#181c1d;font-size:22rpx}.flow-row view text:last-child{color:#3e494a;font-size:18rpx}.info-section text:first-child,.record-head view text:first-child,.resource-card view text:first-child,.simple-row text:first-child{color:#181c1d;font-size:24rpx}.record-head > text{background:#e7f7f5;border-radius:4rpx;color:#00535b;font-size:18rpx;min-width:84rpx;padding:4rpx 10rpx;text-align:center}.action-grid button,.resource-card button{background:#fff;border:1rpx solid #00535b;border-radius:8rpx;color:#00535b;font-size:18rpx;height:44rpx;line-height:44rpx}.primary-action{background:#006d77;border-radius:8rpx;bottom:16rpx;box-shadow:0 8rpx 20rpx rgba(0,109,119,.18);color:#fff;font-size:22rpx;height:56rpx;left:16rpx;line-height:56rpx;position:fixed;right:16rpx;width:auto;z-index:10}