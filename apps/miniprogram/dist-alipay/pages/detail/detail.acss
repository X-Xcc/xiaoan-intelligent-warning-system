page{background:var(--bg);color:var(--text)}.detail-page{background:radial-gradient(circle at 14% 10%,rgba(0,132,255,.14),transparent 22%),linear-gradient(180deg,#fff,#f7fbff);margin:0 auto;max-width:960rpx;min-height:100vh;padding:16rpx 16rpx 96rpx;width:100%}.detail-topbar{align-items:center;display:flex;gap:12rpx;justify-content:space-between;margin-bottom:12rpx}.detail-topbar text{color:var(--muted);font-size:12rpx;font-weight:700;line-height:1.35}.detail-back{background:hsla(0,0%,100%,.68);border:1rpx solid rgba(0,132,255,.14);border-radius:12rpx;color:#1671bd;font-size:13rpx;font-weight:700;height:36rpx;line-height:36rpx;padding:0 12rpx}.detail-hero{background:var(--panel);border:1rpx solid var(--line);border-radius:14rpx;box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.58),0 14rpx 30rpx rgba(0,62,125,.06);padding:16rpx}.detail-hero.help,.detail-hero.serviceOrder{background:radial-gradient(circle at 88% 10%,hsla(0,0%,100%,.16),transparent 110rpx),linear-gradient(135deg,rgba(239,68,68,.92),rgba(245,158,11,.74));color:#fff}.detail-hero.staffOrder{background:radial-gradient(circle at 88% 10%,hsla(0,0%,100%,.16),transparent 110rpx),linear-gradient(135deg,rgba(0,132,255,.92),rgba(16,185,129,.78));color:#fff}.detail-hero.lost,.detail-hero.report{background:radial-gradient(circle at 88% 10%,hsla(0,0%,100%,.16),transparent 110rpx),linear-gradient(135deg,rgba(0,132,255,.9),rgba(245,158,11,.76));color:#fff}.detail-badge,.detail-subtitle,.detail-title{display:block}.detail-badge{background:hsla(0,0%,100%,.72);border-radius:999rpx;color:#1671bd;font-size:12rpx;font-weight:700;line-height:1.35;padding:4rpx 8rpx;width:-moz-fit-content;width:fit-content}.detail-hero.help .detail-badge,.detail-hero.lost .detail-badge,.detail-hero.report .detail-badge,.detail-hero.serviceOrder .detail-badge,.detail-hero.staffOrder .detail-badge{color:#1671bd}.detail-title{color:inherit;font-size:22rpx;font-weight:800;line-height:1.25;margin-top:10rpx}.detail-subtitle{color:inherit;font-size:13rpx;line-height:1.55;margin-top:4rpx;opacity:.88}.about-grid,.bay-dashboard,.bay-note,.detail-tip-grid,.flow-card,.info-section,.order-summary,.policy-row,.record-card,.resource-card,.service-health,.simple-row,.soft-map,.staff-note,.status-card{background:var(--panel);border:1rpx solid var(--line);border-radius:14rpx;box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.58),0 14rpx 30rpx rgba(0,62,125,.06);margin-top:12rpx;padding:14rpx}.status-card{overflow:hidden;position:relative}.status-card::before{background:var(--primary);bottom:0;content:"";left:0;position:absolute;top:0;width:3rpx}.status-card.warn::before{background:var(--warning)}.status-card.danger::before{background:var(--danger)}.status-card.safe::before{background:var(--success)}.about-grid text,.bay-dashboard text,.bay-note text,.detail-tip-grid text,.flow-card text,.info-section text,.order-summary text,.policy-row text,.record-card text,.resource-card text,.service-health text,.simple-row text,.soft-map text,.staff-note text,.status-card text{display:block}.status-card text:first-child{color:var(--muted);font-size:12rpx;font-weight:700;line-height:1.35}.status-card text:nth-child(2){color:var(--text);font-size:24rpx;font-weight:800;line-height:1.15;margin-top:6rpx}.status-card text:last-child{color:var(--muted);font-size:12rpx;line-height:1.55;margin-top:4rpx}.detail-hero.help .status-card text,.detail-hero.lost .status-card text,.detail-hero.report .status-card text,.detail-hero.serviceOrder .status-card text,.detail-hero.staffOrder .status-card text{color:inherit}.order-summary{display:grid;gap:6rpx}.order-summary text:first-child{color:var(--text);font-size:16rpx;font-weight:800;line-height:1.35}.order-summary text{color:var(--muted);font-size:12rpx;line-height:1.55}.soft-map{background:radial-gradient(circle at 18% 18%,hsla(0,0%,100%,.2),transparent 110rpx),linear-gradient(135deg,rgba(0,132,255,.9),rgba(49,154,255,.75));color:#fff;display:flex;flex-direction:column;justify-content:flex-end;min-height:150rpx}.guide-map{background:radial-gradient(circle at 18% 18%,hsla(0,0%,100%,.18),transparent 110rpx),linear-gradient(135deg,rgba(245,158,11,.9),rgba(245,158,11,.68))}.soft-map text:first-child{color:#fff;font-size:16rpx;font-weight:800;line-height:1.35}.soft-map text:last-child{color:hsla(0,0%,100%,.84);font-size:12rpx;line-height:1.55;margin-top:4rpx}.flow-card > text:first-child{color:var(--text);font-size:15rpx;font-weight:800;line-height:1.35;margin-bottom:10rpx}.flow-row{border-top:1rpx solid rgba(7,17,31,.06);display:flex;gap:10rpx;padding:10rpx 0}.flow-row:first-of-type{border-top:0;padding-top:0}.flow-dot{background:#d8e1ea;border:1rpx solid #c7d2de;border-radius:999rpx;height:16rpx;margin-top:4rpx;width:16rpx}.flow-dot.active{background:var(--primary);border-color:var(--primary)}.flow-row view{flex:1}.flow-row view text:first-child{color:var(--text);font-size:13rpx;font-weight:700;line-height:1.35}.flow-row view text:last-child{color:var(--muted);font-size:12rpx;line-height:1.5;margin-top:4rpx}.record-head,.resource-card,.simple-row{align-items:center;display:flex;gap:12rpx;justify-content:space-between}.record-head view,.resource-card view,.simple-row view{flex:1}.info-section text:first-child,.record-head view text:first-child,.resource-card view text:first-child,.simple-row text:first-child{color:var(--text);font-size:14rpx;font-weight:800;line-height:1.35}.info-section text:last-child,.record-head view text:last-child,.resource-card view text:last-child{color:var(--muted);font-size:12rpx;line-height:1.5;margin-top:4rpx}.record-head > text{background:rgba(0,132,255,.08);border-radius:999rpx;color:var(--primary);flex-shrink:0;font-size:12rpx;font-weight:700;line-height:1.2;padding:4rpx 8rpx}.record-card{display:grid;gap:8rpx}.record-desc{color:var(--muted);display:block;font-size:12rpx;line-height:1.55}.action-grid button,.primary-action,.resource-card button{border-radius:12rpx;font-size:13rpx;font-weight:700;height:40rpx;line-height:40rpx}.action-grid button,.resource-card button{background:hsla(0,0%,100%,.68);border:1rpx solid rgba(0,132,255,.14);color:#1671bd;min-width:92rpx}.primary-action{background:linear-gradient(135deg,#0078ff,#0084ff);color:#fff;margin-top:12rpx;width:100%}.simple-row text:last-child{color:var(--primary);font-size:12rpx;font-weight:700;line-height:1.35}.policy-row{color:var(--muted);font-size:12rpx;line-height:1.55}.bay-dashboard{display:grid;gap:8rpx;grid-template-columns:repeat(3,minmax(0,1fr))}.bay-dashboard view{background:hsla(0,0%,100%,.7);border:1rpx solid rgba(0,132,255,.08);border-radius:12rpx;padding:10rpx}.bay-dashboard text:first-child{color:var(--text);font-size:16rpx;font-weight:800;line-height:1.2}.bay-dashboard text:last-child{color:var(--muted);font-size:12rpx;line-height:1.35;margin-top:4rpx}.bay-note,.service-health,.staff-note{background:radial-gradient(circle at 18% 18%,hsla(0,0%,100%,.14),transparent 120rpx),linear-gradient(135deg,rgba(245,158,11,.92),rgba(245,158,11,.7));border-color:rgba(245,158,11,.2);color:#fff}.bay-note text:first-child,.service-health text:first-child,.staff-note text:first-child{color:#fff;font-size:14rpx;font-weight:800;line-height:1.35}.bay-note text:last-child,.service-health text:last-child,.staff-note text:last-child{color:hsla(0,0%,100%,.86);font-size:12rpx;line-height:1.55;margin-top:4rpx}.action-grid{display:grid;gap:8rpx;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:12rpx}.about-grid,.detail-tip-grid{display:grid;gap:8rpx;grid-template-columns:repeat(2,minmax(0,1fr))}.about-grid view,.detail-tip-grid view{background:hsla(0,0%,100%,.68);border:1rpx solid rgba(7,17,31,.08);border-radius:12rpx;padding:12rpx}.about-grid text:first-child,.detail-tip-grid text:first-child{color:var(--primary);font-size:14rpx;font-weight:800;line-height:1.35}.about-grid text:last-child,.detail-tip-grid text:last-child{color:var(--muted);font-size:12rpx;line-height:1.55;margin-top:4rpx}.status-card.blue text:nth-child(2){color:var(--primary)}.status-card.warn text:nth-child(2){color:var(--warning)}.status-card.danger text:nth-child(2){color:var(--danger)}.bay-dashboard,.bay-note,.flow-card,.info-section,.order-summary,.policy-row,.record-card,.resource-card,.service-health,.simple-row,.soft-map,.staff-note{margin-top:12rpx}.detail-toggle{background:hsla(0,0%,100%,.68);border:1rpx solid rgba(0,132,255,.14);color:#1671bd;margin-top:12rpx;width:100%}@media screen and (max-width:420px){.about-grid,.action-grid,.bay-dashboard,.detail-tip-grid{grid-template-columns:1fr}.resource-card,.simple-row{align-items:flex-start}}