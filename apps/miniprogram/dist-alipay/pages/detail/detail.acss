page{background:#f5f7f6;color:#18211f}.detail-page{background:linear-gradient(180deg,#eefaf3,#f5f7f6 42%,#f5f7f6);min-height:100%;padding:24rpx 24rpx 156rpx;width:100%}.detail-page{background:#f2f5f4}.about-grid,.bay-dashboard,.bay-note,.detail-hero,.detail-tip-grid,.flow-card,.info-section,.order-summary,.policy-row,.record-card,.resource-card,.service-health,.simple-row,.soft-map,.staff-note,.status-card{border-color:#dfe9e4;border-radius:12rpx;box-shadow:0 8rpx 22rpx #1432270d}.detail-hero{background:#087c59}.detail-hero.help,.detail-hero.serviceOrder{background:#c94343}.action-grid button,.detail-back,.detail-toggle,.resource-card button{border-radius:10rpx;min-height:82rpx}.primary-action{background:#087c59;border-radius:10rpx}.detail-topbar{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.detail-brand{align-items:center;color:#66736f;display:inline-flex;font-size:24rpx;font-weight:700;gap:10rpx;line-height:1.35}.detail-brand-logo{flex:0 0 34rpx;height:34rpx;width:34rpx}.detail-topbar text{color:#66736f;font-size:24rpx;font-weight:700;line-height:1.35}.detail-back{background:#fff;border:1rpx solid #07c1602e;border-radius:16rpx;color:#07a85a;font-size:24rpx;font-weight:800;line-height:68rpx;min-height:68rpx;padding:0 24rpx}.about-grid,.bay-dashboard,.bay-note,.detail-hero,.detail-tip-grid,.flow-card,.info-section,.order-summary,.policy-row,.record-card,.resource-card,.service-health,.simple-row,.soft-map,.staff-note,.status-card{background:#fff;border:1rpx solid #14201c0f;border-radius:18rpx;box-shadow:0 12rpx 32rpx #18211f0f;margin-top:16rpx;padding:26rpx}.detail-hero{background:linear-gradient(142deg,#07c160,#13a36f 54%,#256d5a);color:#fff;margin-top:0;padding:34rpx 28rpx}.detail-hero.help,.detail-hero.serviceOrder{background:linear-gradient(142deg,#e5484d,#d97706)}.detail-badge,.detail-subtitle,.detail-title{display:block}.detail-badge{background:#ffffffe6;border-radius:999rpx;color:#07a85a;font-size:24rpx;font-weight:800;lin