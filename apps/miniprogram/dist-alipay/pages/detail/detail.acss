page{background:#f4f8f5;color:#173b3a;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif}button::after{border:none}button{margin:0}button,image,input,map,text,textarea,view{box-sizing:border-box}.detail-page{background:linear-gradient(180deg,rgba(224,244,232,.75),rgba(244,248,245,0) 270rpx),#f4f8f5;min-height:100vh;padding:24rpx 24rpx 44rpx}.detail-topbar{align-items:center;display:flex;height:58rpx;justify-content:space-between;margin-bottom:12rpx}.detail-topbar text{color:#71857f;font-size:22rpx;font-weight:800}.detail-back{background:#e4f4ed;border-radius:999rpx;color:#0b776c;font-size:22rpx;font-weight:900;height:52rpx;line-height:52rpx;width:132rpx}.detail-hero{background:radial-gradient(circle at 88% 8%,hsla(0,0%,100%,.28),transparent 160rpx),linear-gradient(145deg,#087f76,#26a988 62%,#f3b957);border-radius:30rpx;box-shadow:0 20rpx 44rpx rgba(17,116,91,.2);color:#fff;display:flex;flex-direction:column;justify-content:flex-end;min-height:228rpx;padding:28rpx}.detail-hero.help,.detail-hero.serviceOrder{background:radial-gradient(circle at 86% 10%,hsla(0,0%,100%,.25),transparent 160rpx),linear-gradient(145deg,#c44b35,#eb6a4a 62%,#f3b957)}.detail-hero.staffOrder{background:radial-gradient(circle at 88% 8%,hsla(0,0%,100%,.22),transparent 160rpx),linear-gradient(145deg,#142b35,#237c7a)}.detail-hero.lost,.detail-hero.report{background:radial-gradient(circle at 88% 8%,hsla(0,0%,100%,.24),transparent 160rpx),linear-gradient(145deg,#7f6540,#d69635)}.detail-badge,.detail-subtitle,.detail-title{display:block}.detail-badge{background:#ffe19b;color:#173b3a;font-size:21rpx;font-weight:900;padding:8rpx 14rpx;width:-moz-fit-content;width:fit-content}.detail-title{font-size:46rpx;font-weight:900;line-height:1.15;margin-top:18rpx}.detail-subtitle{color:hsla(0,0%,100%,.86);font-size:23rpx;margin-top:10rpx}.about-grid,.bay-dashboard,.bay-note,.detail-tip-grid,.flow-card,.info-section,.order-summary,.policy-row,.record-card,.resource-card,.service-h