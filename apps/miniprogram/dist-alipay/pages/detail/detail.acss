t-child,.record-head view text:last-child,.resource-card view text:last-child{color:#71857f;display:block;font-size:22rpx;line-height:1.45;margin-top:8rpx}.record-head > text{background:#e1f4eb;border-radius:999rpx;color:#0b776c;font-size:20rpx;font-weight:900;padding:8rpx 12rpx}.record-desc{color:#58706a;display:block;font-size:23rpx;line-height:1.45;margin-top:18rpx}.primary-action,.resource-card button{background:#0b8f7d;border-radius:14rpx;color:#fff;flex-shrink:0;font-size:21rpx;font-weight:900;height:58rpx;line-height:58rpx}.resource-card button{width:138rpx}.primary-action{margin-top:20rpx;max-width:100%;width:100%}.simple-row text:last-child{color:#0b8f7d;font-size:21rpx;font-weight:900}.policy-row{color:#58706a;font-size:24rpx;line-height:1.5}.order-summary{display:grid;gap:11rpx}.order-summary text{color:#58706a;display:block;font-size:23rpx;line-height:1.45}.order-summary text:first-child{color:#173b3a;font-size:33rpx;font-weight:900}.soft-map{background:radial-gradient(circle at 18% 18%,hsla(0,0%,100%,.22),transparent 130rpx),linear-gradient(145deg,#237c7a,#0b8f7d);color:#fff;min-height:168rpx}.soft-map text:first-child{display:block;font-size:30rpx;font-weight:900}.soft-map text:last-child{color:hsla(0,0%,100%,.84);display:block;font-size:22rpx;line-height:1.4;margin-top:10rpx}.guide-map{background:radial-gradient(circle at 86% 16%,hsla(0,0%,100%,.2),transparent 130rpx),linear-gradient(145deg,#d69635,#f3b957)}.flow-card > text:first-child{color:#173b3a;font-size:29rpx;margin-bottom:8rpx}.flow-row{border-top:1rpx solid #e8efeb;display:flex;gap:14rpx;padding:16rpx 0}.flow-dot{background:#d8e6df;height:22rpx;margin-top:5rpx;width:22rpx}.flow-dot.active{background:#0b8f7d;box-shadow:0 0 0 8rpx rgba(11,143,125,.1)}.flow-row view text:first-child{color:#173b3a;display:block;font-size:24rpx;font-weight:900}.flow-row view text:last-child{color:#71857f;display:block;font-size:21rpx;margin-top:6rpx}.action-grid{display:grid;gap:14rpx;grid-template-columns:repeat(