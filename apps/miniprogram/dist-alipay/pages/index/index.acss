page{background:#f4f8f5;color:#173b3a;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif}button::after{border:none}button{margin:0}.login-shell{background:linear-gradient(155deg,#d5ebe1,#edf5f0 48%,#f7f8f3);min-height:100vh;padding:30rpx 24rpx}.login-card{align-items:center;background:linear-gradient(180deg,hsla(0,0%,100%,.9),hsla(0,0%,100%,.96) 58%,rgba(244,249,245,.98));border:1rpx solid rgba(23,59,58,.08);border-radius:18rpx;box-shadow:0 18rpx 42rpx rgba(23,59,58,.1);display:flex;flex-direction:column;min-height:82vh;overflow:hidden;padding:48rpx 28rpx 28rpx;position:relative}.login-card::after{background:linear-gradient(170deg,transparent 0 42%,rgba(117,181,163,.16) 42% 47%,transparent 47% 57%,rgba(61,139,160,.1) 57% 62%,transparent 62%);bottom:-34rpx;content:"";height:150rpx;left:-16rpx;position:absolute;right:-16rpx;transform:rotate(-3deg)}.login-kicker{color:#52736c;display:block;font-size:20rpx;font-weight:800;letter-spacing:2rpx;margin-bottom:22rpx;position:relative;z-index:1}.brand-mark{align-items:center;background:#e4f2ea;border:1rpx solid rgba(11,119,108,.12);border-radius:18rpx;box-shadow:0 12rpx 26rpx rgba(11,143,125,.12);display:flex;height:116rpx;justify-content:center;position:relative;width:116rpx;z-index:1}.brand-logo{border-radius:14rpx;display:block;height:86rpx;width:86rpx}.login-title{color:#173b3a;display:block;font-size:48rpx;font-weight:900;line-height:1.16;margin-top:24rpx;position:relative;z-index:1}.login-subtitle{color:#617a73;display:block;font-size:22rpx;line-height:1.45;margin-top:12rpx;max-width:480rpx;position:relative;text-align:center;z-index:1}.login-value{display:grid;gap:10rpx;grid-template-columns:repeat(3,1fr);margin-bottom:auto;margin-top:30rpx;position:relative;width:100%;z-index:1}.login-value text{align-items:center;background:#eef7f1;border:1rpx solid rgba(11,119,108,.08);border-radius:12rpx;color:#0b776c;display:flex;font-size:19rpx;font-weight:800;justify-content:center;min-height:56rpx}.wechat-login{background:#0b8f7d;border-radius:14rpx;box-shadow:0 12rpx 24rpx rgba(11,143,125,.2);color:#fff;font-size:27rpx;font-weight:900;height:76rpx;line-height:76rpx;margin-top:40rpx;position:relative;width:100%;z-index:1}.staff-login-entry{background:rgba(243,247,244,.78);border:1rpx solid #d9e7df;border-radius:12rpx;color:#617a73;font-size:22rpx;height:50rpx;line-height:50rpx;margin-top:14rpx;position:relative;width:72%;z-index:1}