page{background:#edf3ef;color:#173331;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif}button,image,input,map,text,textarea,view{box-sizing:border-box}button::after{border:none}button{margin:0}.login-shell{background:linear-gradient(180deg,rgba(234,246,240,.94),hsla(84,24%,96%,.96)),linear-gradient(135deg,#b9dde4,#f2d59b);padding:32rpx 24rpx}.login-card{background:#fffdf8;border:1rpx solid rgba(24,55,52,.08);border-radius:16rpx;box-shadow:0 18rpx 38rpx rgba(35,71,66,.12);display:flex;flex-direction:column;min-height:84vh;overflow:hidden;padding:38rpx 28rpx 28rpx;position:relative}.login-language{margin-bottom:20rpx;position:relative;z-index:1}.login-card::before{background:linear-gradient(174deg,transparent 0 31%,rgba(86,161,178,.9) 31% 54%,transparent 54%),linear-gradient(168deg,transparent 0 45%,rgba(123,179,126,.76) 45% 72%,transparent 72%);content:"";height:260rpx;left:-18%;position:absolute;right:-18%;top:168rpx;transform:rotate(-3deg)}.login-card::after{background:rgba(23,51,49,.12);bottom:164rpx;content:"";height:1rpx;left:28rpx;position:absolute;right:28rpx}.brand-mark,.login-kicker,.login-subtitle,.login-title,.login-value,.staff-login-entry,.wechat-login{position:relative;z-index:1}.login-kicker{background:#e5f3ed;border-radius:999rpx;color:#0f6f64;display:block;font-size:19rpx;font-weight:900;padding:8rpx 14rpx;width:-moz-fit-content;width:fit-content}.brand-mark{align-items:center;background:hsla(0,0%,100%,.9);border:1rpx solid rgba(15,111,100,.14);border-radius:16rpx;box-shadow:0 12rpx 24rpx rgba(24,55,52,.12);display:flex;height:112rpx;justify-content:center;margin-top:86rpx;width:112rpx}.brand-logo{display:block;height:84rpx;width:84rpx}.login-title{color:#173331;display:block;font-size:54rpx;line-height:1.08}.login-subtitle{color:#5d716b;display:block;font-size:23rpx;line-height:1.48;margin-top:12rpx;max-width:500rpx}.login-value{gap:10rpx;margin-bottom:28rpx;margin-top:auto}.login-value text{align-items:center;background:#f3f7f3;border:1rpx solid rgba(24,55,52,.08);border-radius:10rpx;color:#24443f;display:flex;font-size:20rpx;font-weight:900;justify-content:center;min-height:64rpx}.wechat-login{background:#0f7f72;border-radius:12rpx;box-shadow:0 12rpx 22rpx rgba(15,127,114,.2);color:#fff;font-size:27rpx;font-weight:900;height:76rpx;line-height:76rpx;width:100%}.staff-login-entry{background:#f1f5f1;border:1rpx solid rgba(24,55,52,.1);border-radius:12rpx;color:#526862;font-size:22rpx;height:58rpx;line-height:58rpx;margin-top:14rpx;width:100%}.language-picker{background:hsla(0,0%,100%,.72);border:1rpx solid rgba(24,55,52,.08);border-radius:14rpx;padding:14rpx 14rpx 10rpx}.language-picker-head{align-items:center;display:flex;gap:12rpx;justify-content:space-between;margin-bottom:10rpx}.language-picker-label{color:#5b716c;font-size:18rpx;font-weight:800}.language-picker-current{color:#0f6f64;font-size:18rpx;font-weight:900}.language-options{display:flex;flex-wrap:wrap;gap:8rpx}.language-option{background:#f3f7f3;border:1rpx solid rgba(24,55,52,.08);border-radius:10rpx;min-width:92rpx;padding:10rpx 12rpx;position:relative}.language-option text{display:block}.language-option text:first-child{color:#173331;font-size:18rpx;font-weight:900}.language-option text:nth-child(2){color:#6b7f79;font-size:14rpx;line-height:1.25;margin-top:4rpx}.language-option.selected{background:#e2f2ed;border-color:rgba(15,127,114,.26)}.language-check{color:#0f7f72;font-size:16rpx;font-weight:900;position:absolute;right:8rpx;top:8rpx}.login-shell{background:linear-gradient(180deg,#e8f8f5,#f7fbf8 52%,#f5f7f2);min-height:100vh;overflow:hidden;padding:0;position:relative}.login-illustration{inset:0;overflow:hidden;position:absolute}.river-shape{border-radius:50%;left:-18%;position:absolute;transform:rotate(-10deg);width:136%}.river-shape-a{background:rgba(0,109,119,.16);height:420rpx;top:300rpx}.river-shape-b{background:hsla(16,65%,68%,.18);height:390rpx;top:500rpx}.login-content{align-items:stretch;display:flex;flex-direction:column;min-height:100vh;overflow-x:hidden;padding:142rpx 23rpx 28rpx;position:relative;width:100%;z-index:1}.brand-header{align-items:center;display:flex;flex-direction:column;text-align:center;width:100%}.brand-mark{background:hsla(0,0%,100%,.92);border:1rpx solid rgba(190,200,202,.42);border-radius:10rpx;box-shadow:0 8rpx 20rpx rgba(0,109,119,.08);height:64rpx;margin-top:0;width:96rpx}.brand-logo{height:44rpx;width:72rpx}.login-title{color:#181c1d;font-size:48rpx;font-weight:900;line-height:1;margin-top:28rpx}.login-subtitle{color:#3e494a;font-size:24rpx;line-height:1.5;margin-top:8rpx;max-width:416rpx;text-align:center}.login-panel{background:#fff;border:1rpx solid rgba(190,200,202,.6);border-radius:12rpx;box-shadow:0 2rpx 8rpx rgba(0,109,119,.05);margin-top:56rpx;max-width:100%;padding:24rpx;width:auto}.trust-card{align-items:flex-start;background:#f7fbfb;border:1rpx solid #ebeeef;border-radius:10rpx;display:flex;gap:16rpx;min-height:102rpx;padding:16rpx;width:100%}.trust-icon{color:#006d77;font-size:32rpx;line-height:1;text-align:center;width:32rpx}.trust-card view{flex:1;min-width:0}.trust-card text{display:block}.trust-card view text:first-child{color:#181c1d;font-size:24rpx;font-weight:900;line-height:1.35}.trust-card view text:last-child{color:#3e494a;font-size:20rpx;line-height:1.45;margin-top:6rpx}.login-value{display:grid;gap:8rpx;grid-template-columns:repeat(3,1fr);margin:20rpx 0 0}.login-value text{background:#f1f4f4;border:none;border-radius:8rpx;color:#3e494a;font-size:18rpx;font-weight:800;min-height:46rpx}.login-actions{display:flex;flex-direction:column;gap:16rpx;margin-top:24rpx}.staff-login-entry,.wechat-login{border-radius:8rpx;font-size:22rpx;font-weight:900;height:64rpx;line-height:64rpx;max-width:100%;width:100%}.wechat-login{background:#006d77;box-shadow:0 2rpx 8rpx rgba(0,109,119,.16)}.staff-login-entry{background:#fff;border:1rpx solid #00535b;color:#00535b;margin-top:0}.login-language{margin-bottom:14rpx;margin-top:auto}.language-picker{background:hsla(0,0%,100%,.86);border-radius:10rpx;box-shadow:0 2rpx 8rpx rgba(0,109,119,.05)}.login-support{color:#3e494a;display:block;font-size:18rpx;line-height:1.35;text-align:center}.login-error{color:#9a2d1f;display:block;font-size:18rpx;line-height:1.35;margin-top:12rpx;text-align:center}.language-picker.collapsed{padding:12rpx 14rpx}.language-picker-summary{align-items:center;display:flex;gap:8rpx}.language-picker-arrow{color:#8aa09d;font-size:18rpx;font-weight:900}.language-picker.open .language-options{margin-top:12rpx}.wechat-auth-shell{background:#f7f8f7;min-height:100vh;padding:0}.wechat-auth-shell .login-illustration{display:none}.wechat-auth-content{background:#f7f8f7;display:flex;flex-direction:column;min-height:100vh;padding:88rpx 32rpx 28rpx}.auth-brand{padding-top:22rpx}.auth-brand .brand-mark{background:#fff;border:1rpx solid #e8ecea;border-radius:16rpx;box-shadow:0 8rpx 18rpx rgba(20,45,42,.06);height:76rpx;margin:0 auto;width:76rpx}.auth-brand .brand-logo{height:54rpx;width:54rpx}.auth-brand .login-title{color:#111;font-size:42rpx;font-weight:800;line-height:1.18;margin-top:20rpx}.auth-brand .login-subtitle{color:#666;font-size:22rpx;line-height:1.45;margin:10rpx auto 0;max-width:440rpx}.auth-panel{background:#fff;border:1rpx solid #e9eeec;border-radius:12rpx;box-shadow:0 8rpx 24rpx rgba(17,33,30,.05);margin-top:56rpx;padding:0}.auth-account-card{align-items:center;border-bottom:1rpx solid #eef2f0;display:flex;gap:16rpx;min-height:116rpx;padding:22rpx}.auth-wechat-avatar{align-items:center;background:#07c160;border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:24rpx;font-weight:900;height:58rpx;justify-content:center;width:58rpx}.auth-account-card > view:last-child{flex:1;min-width:0}.auth-account-card text{display:block}.auth-account-card text:first-child{color:#111;font-size:26rpx;font-weight:800;line-height:1.3}.auth-account-card text:last-child{color:#777;font-size:20rpx;line-height:1.35;margin-top:6rpx}.auth-scope-list{padding:6rpx 22rpx 0}.auth-scope-list > view{border-bottom:1rpx solid #f0f3f2;min-height:70rpx;padding:14rpx 0}.auth-scope-list > view:last-child{border-bottom:0}.auth-scope-list text{display:block}.auth-scope-list text:first-child{color:#222;font-size:22rpx;font-weight:700;line-height:1.3}.auth-scope-list text:last-child{color:#858585;font-size:19rpx;line-height:1.35;margin-top:4rpx}.auth-panel .login-actions{gap:12rpx;margin-top:8rpx;padding:0 22rpx 22rpx}.auth-panel .wechat-login{align-items:center;background:#07c160;border-radius:8rpx;box-shadow:none;color:#fff;display:flex;font-size:24rpx;gap:10rpx;height:72rpx;justify-content:center;line-height:72rpx}.wechat-login-mark{align-items:center;background:#fff;border-radius:50%;color:#07c160;display:flex;font-size:18rpx;font-weight:900;height:32rpx;justify-content:center;line-height:32rpx;width:32rpx}.auth-panel .staff-login-entry{background:transparent;border:none;color:#576b95;font-size:21rpx;height:58rpx;line-height:58rpx}.auth-panel .login-error{color:#d54941;font-size:18rpx;margin:-8rpx 22rpx 18rpx}.wechat-auth-content .login-language{margin-bottom:14rpx;margin-top:auto}.wechat-auth-content .language-picker{background:#fff;border:1rpx solid #e9eeec;box-shadow:none}.wechat-auth-content .login-support{color:#8a8a8a;font-size:18rpx;line-height:1.45}