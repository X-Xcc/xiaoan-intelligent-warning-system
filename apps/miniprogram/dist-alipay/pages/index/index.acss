page{background:var(--bg);color:var(--text)}.login-shell{background:radial-gradient(circle at 14% 10%,rgba(0,132,255,.22),transparent 24%),radial-gradient(circle at 86% 12%,rgba(49,154,255,.14),transparent 22%),linear-gradient(180deg,#fff,#f7fbff);min-height:100vh;overflow:hidden;padding:24rpx 16rpx 28rpx;position:relative}.login-shell::after,.login-shell::before{border-radius:50%;content:"";pointer-events:none;position:absolute}.login-shell::before{background:radial-gradient(circle,rgba(0,132,255,.14),transparent 68%);height:72vw;left:-14%;top:260rpx;width:72vw}.login-shell::after{background:radial-gradient(circle,rgba(16,185,129,.1),transparent 68%);bottom:-12%;height:64vw;right:-18%;width:64vw}.login-content,.wechat-auth-content{display:flex;flex-direction:column;gap:14rpx;margin:0 auto;max-width:560rpx;position:relative;width:100%;z-index:1}.brand-header{align-items:flex-start;display:flex;flex-direction:column;gap:10rpx;width:100%}.brand-mark{align-items:center;background:hsla(0,0%,100%,.78);border:1rpx solid rgba(0,132,255,.16);border-radius:16rpx;box-shadow:inset 0 4rpx 4rpx hsla(0,0%,100%,.6),0 14rpx 32rpx rgba(0,62,125,.1);display:flex;height:76rpx;justify-content:center;width:76rpx}.brand-logo{height:54rpx;width:54rpx}.login-title{color:var(--text);display:block;font-size:28rpx;font-weight:800;line-height:1.08}.login-subtitle{color:var(--muted);display:block;font-size:14rpx;line-height:1.6;max-width:470rpx}.login-value{display:grid;gap:8rpx;grid-template-columns:repeat(3,minmax(0,1fr))}.login-value view{background:var(--panel);border:1rpx solid var(--line);border-radius:14rpx;box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.58),0 12rpx 26rpx rgba(0,62,125,.06);min-height:78rpx;padding:12rpx}.login-value text{display:block}.login-value text:first-child{color:var(--subtle);font-size:11rpx;font-weight:800;line-height:1.35}.login-value text:last-child{color:var(--text);font-size:14rpx;font-weight:700;line-height:1.45;margin-top:8rpx}.login-panel{backdrop-filter:blur(20rpx);background:var(--panel);border:1rpx solid var(--line);border-radius:14rpx;box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.6),0 18rpx 40rpx rgba(0,62,125,.08);padding:16rpx}.auth-account-card{align-items:flex-start;border-bottom:1rpx solid rgba(7,17,31,.06);display:flex;gap:12rpx;padding-bottom:14rpx}.auth-wechat-avatar{align-items:center;background:var(--primary);border-radius:14rpx;box-shadow:0 10rpx 22rpx rgba(0,132,255,.18);color:#fff;display:flex;flex-shrink:0;font-size:18rpx;font-weight:800;height:46rpx;justify-content:center;width:46rpx}.auth-account-card view:last-child{flex:1;min-width:0}.auth-account-card text{display:block}.auth-account-card text:first-child{color:var(--text);font-size:16rpx;font-weight:700;line-height:1.35}.auth-account-card text:last-child{color:var(--muted);font-size:12rpx;line-height:1.55;margin-top:4rpx}.auth-scope-list{display:grid;gap:8rpx;padding:14rpx 0 0}.auth-scope-list > view{background:hsla(0,0%,100%,.68);border:1rpx solid rgba(0,132,255,.08);border-radius:12rpx;padding:10rpx 12rpx}.auth-scope-list text{display:block}.auth-scope-list text:first-child{color:var(--text);font-size:13rpx;font-weight:700;line-height:1.35}.auth-scope-list text:last-child{color:var(--muted);font-size:12rpx;line-height:1.5;margin-top:4rpx}.login-actions{display:grid;gap:10rpx;margin-top:14rpx}.staff-login-entry,.wechat-login{align-items:center;border-radius:12rpx;display:flex;font-size:15rpx;font-weight:800;gap:8rpx;height:48rpx;justify-content:center;line-height:48rpx;width:100%}.wechat-login{background:linear-gradient(135deg,#0078ff,#0084ff);box-shadow:inset 0 4rpx 4rpx hsla(0,0%,100%,.22),0 16rpx 34rpx rgba(0,132,255,.2);color:#fff}.wechat-login-mark{align-items:center;background:#fff;border-radius:999rpx;color:var(--primary);display:flex;font-size:12rpx;font-weight:800;height:24rpx;justify-content:center;width:24rpx}.staff-login-entry{background:hsla(0,0%,100%,.66);border:1rpx solid rgba(0,132,255,.14);color:#1671bd}.login-language{background:var(--panel);border:1rpx solid var(--line);border-radius:14rpx;box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.58),0 12rpx 26rpx rgba(0,62,125,.05);padding:14rpx}.language-picker{padding:0}.language-picker-head{align-items:center;display:flex;gap:10rpx;justify-content:space-between}.language-picker-label{color:var(--subtle);font-size:12rpx;font-weight:800}.language-picker-summary{align-items:center;display:flex;gap:8rpx}.language-picker-current{color:#1671bd;font-size:12rpx;font-weight:800}.language-picker-arrow{color:var(--subtle);font-size:12rpx;font-weight:800}.language-options{display:grid;gap:8rpx;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:10rpx}.language-option{background:hsla(0,0%,100%,.66);border:1rpx solid rgba(7,17,31,.08);border-radius:12rpx;min-height:54rpx;padding:8rpx 10rpx;position:relative}.language-option text{display:block}.language-option text:first-child{color:var(--text);font-size:13rpx;font-weight:700}.language-option text:nth-child(2){color:var(--muted);font-size:11rpx;line-height:1.25;margin-top:2rpx}.language-option.selected{background:rgba(0,132,255,.08);border-color:rgba(0,132,255,.18)}.language-check{color:var(--primary);font-size:12rpx;font-weight:800;position:absolute;right:8rpx;top:8rpx}.login-support{color:var(--subtle);display:block;font-size:12rpx;line-height:1.55;text-align:center}.login-error{color:var(--danger);display:block;font-size:12rpx;line-height:1.45;margin-top:8rpx;text-align:center}@media screen and (max-width:420px){.language-options,.login-value{grid-template-columns:1fr}}