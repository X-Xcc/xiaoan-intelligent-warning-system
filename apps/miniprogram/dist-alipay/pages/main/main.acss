taff-task-tags{display:flex;flex-wrap:wrap;gap:6rpx}.staff-task-tag{background:hsla(0,0%,100%,.7);border-radius:999rpx;color:var(--muted);font-size:11rpx;font-weight:700;padding:4rpx 8rpx}.staff-task-tag.danger{background:var(--danger-soft);color:var(--danger)}.staff-task-tag.muted{background:rgba(0,132,255,.08)}.staff-task-title{color:var(--text);display:block;font-size:15rpx;font-weight:800;line-height:1.35;margin-top:10rpx}.staff-task-location{border-bottom:1rpx solid rgba(7,17,31,.06);margin-top:6rpx;padding-bottom:10rpx}.staff-task-location text:first-child{color:var(--primary)}.staff-task-location text:last-child{color:var(--muted);font-size:12rpx;line-height:1.45}.staff-task-detail{background:hsla(0,0%,100%,.58);border-radius:12rpx;margin-top:10rpx;padding:12rpx}.staff-task-detail text{display:block}.staff-task-detail text:first-child{color:var(--text);font-size:12rpx;line-height:1.55}.staff-task-detail text:last-child{color:var(--muted);font-size:12rpx;line-height:1.45;margin-top:8rpx}.compact-line{margin-top:10rpx}.staff-task-actions{flex-wrap:wrap;margin-top:12rpx}.staff-link-action,.staff-primary-action,.staff-secondary-action{flex:1;min-width:96rpx}.staff-link-action{flex:0 0 72rpx}.staff-subpage{display:grid;gap:12rpx}.bay-dashboard text,.body-copy,.content-card text,.ledger-row text,.mine-section text,.profile-card text,.record-card text,.resource-row text,.soft-map text,.staff-profile text,.staff-summary-card text,.status-card text{display:block}.content-card text:first-child,.mine-section > text,.profile-card text:first-child,.staff-profile text:first-child,.staff-summary-card text:first-child{color:var(--text);font-size:15rpx;font-weight:800;line-height:1.35}.body-copy,.content-card .body-copy,.profile-card text:last-child,.staff-profile text:last-child,.staff-summary-card text:last-child{color:var(--muted);font-size:12rpx;line-height:1.55}.staff-map{border:1rpx solid var(--line);border-radius:14rpx;box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.58),0 14rpx 30rpx rgba(0,62,125,.06);height:280rpx;overflow:hidden}.staff-map .native-map{height:100%;width:100%}.map-legend{display:flex;flex-wrap:wrap;gap:10rpx}.map-legend view{align-items:center;display:flex;gap:6rpx}.legend-dot{border-radius:999rpx;height:8rpx;width:8rpx}.legend-dot.safe{background:var(--success)}.legend-dot.warn{background:var(--warning)}.legend-dot.danger{background:var(--danger)}.legend-dot.service{background:var(--primary)}.ledger-card{display:grid;gap:8rpx}.ledger-row{border-bottom:1rpx solid rgba(7,17,31,.06);padding:10rpx 0}.ledger-row:last-child{border-bottom:0}.ledger-head{color:var(--muted);font-size:12rpx;font-weight:700;padding-top:0}.ledger-row view text:first-child{color:var(--text);font-size:13rpx;font-weight:700;line-height:1.4}.ledger-row view text:last-child{color:var(--muted);font-size:12rpx;line-height:1.45;margin-top:4rpx}.resource-row{border-bottom:1rpx solid rgba(7,17,31,.06);padding:10rpx 0}.resource-row:last-child{border-bottom:0}.resource-row view text:first-child{color:var(--text);font-size:13rpx;font-weight:700;line-height:1.35}.resource-row view text:last-child{color:var(--muted);font-size:12rpx;line-height:1.45;margin-top:4rpx}.resource-row > text,.resource-row button{flex-shrink:0}.mine-page{display:grid;gap:12rpx}.mine-topbar{align-items:center;display:flex;gap:12rpx;justify-content:space-between}.mine-topbar text{display:block}.mine-topbar text:first-child{color:var(--text);font-size:20rpx;font-weight:800;line-height:1.25}.mine-topbar text:last-child{color:var(--muted);font-size:12rpx;line-height:1.35}.profile-card,.staff-profile{align-items:center;display:flex;gap:12rpx}.avatar,.staff-avatar{align-items:center;background:linear-gradient(135deg,#0078ff,#0084ff);border-radius:14rpx;color:#fff;display:flex;flex-shrink:0;font-size:18rpx;font-weight:800;height:48rpx;justify-content:center;width:48rpx}.staff-avatar{background:linear-gradient(135deg,#0078ff,#10b981)}.online-dot{background:var(--success-soft);border-radius:999rpx;color:var(--success);flex-shrink:0;font-size:11rpx;font-weight:700;padding:4rpx 8rpx}.mine-section{display:grid;gap:0;overflow:hidden;padding:0}.mine-section > text{border-bottom:1rpx solid rgba(7,17,31,.06);padding:12rpx 14rpx}.mine-row{border-bottom:1rpx solid rgba(7,17,31,.06);min-height:48rpx;padding:0 14rpx}.mine-row:last-child{border-bottom:0}.mine-row text:first-child{color:var(--text);font-size:13rpx;font-weight:700;line-height:1.35}.mine-row text:last-child{color:var(--subtle);font-size:16rpx;line-height:1}.logout{background:hsla(0,0%,100%,.66);border:1rpx solid rgba(0,132,255,.14);color:#1671bd;font-size:14rpx;height:44rpx;line-height:44rpx;width:100%}.compact-language{margin-top:0}.language-picker{padding:14rpx}.language-picker-head,.language-picker-summary{align-items:center;display:flex;gap:10rpx;justify-content:space-between}.language-picker-label{color:var(--subtle);font-size:12rpx;font-weight:800}.language-picker-current{color:var(--primary);font-size:12rpx;font-weight:800}.language-picker-arrow{color:var(--subtle);font-size:12rpx;font-weight:800}.language-options{display:grid;gap:8rpx;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:10rpx}.language-option{background:hsla(0,0%,100%,.66);border:1rpx solid rgba(7,17,31,.08);border-radius:12rpx;min-height:54rpx;padding:8rpx 10rpx;position:relative}.language-option text{display:block}.language-option text:first-child{color:var(--text);font-size:13rpx;font-weight:700}.language-option text:nth-child(2){color:var(--muted);font-size:11rpx;line-height:1.25;margin-top:2rpx}.language-option.selected{background:rgba(0,132,255,.08);border-color:rgba(0,132,255,.18)}.language-check{color:var(--primary);font-size:12rpx;font-weight:800;position:absolute;right:8rpx;top:8rpx}.tabbar{backdrop-filter:blur(20rpx);background:hsla(0,0%,100%,.88);border:1rpx solid var(--line);border-radius:14rpx;bottom:calc(12rpx + env(safe-area-inset-bottom));box-shadow:inset 0 3rpx 4rpx hsla(0,0%,100%,.62),0 18rpx 40rpx rgba(0,62,125,.1);display:grid;gap:8rpx;grid-template-columns:repeat(5,minmax(0,1fr));left:12rpx;padding:8rpx;position:fixed;right:12rpx;z-index:20}.tab-item{align-items:center;background:transparent;border-radius:12rpx;color:var(--muted);display:flex;font-size:12rpx;font-weight:700;justify-content:center;line-height:1.2;min-height:40rpx;padding:8rpx 6rpx;text-align:center}.tab-item.active{background:rgba(0,132,255,.08);color:var(--primary)}.tab-item.help-tab{background:var(--danger);color:#fff}.tab-item.help-tab.active{background:#dc2626}.tab-item text{display:block}.help-page.help-hero-page{align-items:center;background:radial-gradient(circle at 18% 14%,rgba(0,132,255,.18),transparent 24%),radial-gradient(circle at 78% 12%,rgba(49,154,255,.1),transparent 20%),linear-gradient(180deg,#fff,#f7fbff);display:flex;justify-content:center;min-height:calc(100vh - 96rpx);padding-bottom:96rpx;padding-top:24rpx}.help-stage{display:grid;gap:12rpx;justify-items:center;max-width:480rpx;width:100%}.help-halo{display:none}.help-orb{align-items:center;aspect-ratio:1;background:radial-gradient(circle at 35% 24%,hsla(0,0%,100%,.98),hsla(0,0%,100%,.78) 36%,rgba(0,132,255,.12) 100%);border:1rpx solid rgba(0,132,255,.16);border-radius:50%;box-shadow:inset 0 4rpx 4rpx hsla(0,0%,100%,.46),0 24rpx 52rpx rgba(0,132,255,.14);color:var(--primary);display:flex;flex-direction:column;gap:8rpx;justify-content:center;padding:24rpx;position:relative;width:min(78vw,320rpx)}.help-orb.active{background:radial-gradient(circle at 35% 24%,hsla(0,0%,100%,.98),hsla(0,0%,100%,.78) 36%,rgba(16,185,129,.12) 100%);border-color:rgba(16,185,129,.18);color:#0f766e}.help-orb::after{border:1rpx solid rgba(0,132,255,.08);border-radius:50%;content:"";inset:12rpx;position:absolute}.help-orb text{display:block;text-align:center}.help-orb-kicker{color:inherit;font-size:12rpx;font-weight:800;line-height:1.35}.help-orb-title{color:var(--text);font-size:58rpx;font-weight:800;line-height:1}.help-orb-sub{color:var(--muted);font-size:12rpx;line-height:1.5;max-width:220rpx}.help-note{color:var(--subtle);font-size:12rpx;line-height:1.55;max-width:360rpx;text-align:center}.body-copy{display:block}.error-card{background:var(--danger-soft);border:1rpx solid rgba(239,68,68,.16);border-radius:12rpx;padding:12rpx}.error-card text{color:var(--danger);display:block;font-size:12rpx;line-height:1.45}@media screen and (max-width:420px){.home-key-tiles,.home-status-grid,.staff-task-metrics{grid-template-columns:1fr}.choice-grid,.progress-actions,.progress-page .segmented,.staff-nav{grid-template-columns:1fr}.bay-choice,.figma-service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.tabbar{grid-template-columns:repeat(5,minmax(0,1fr))}}