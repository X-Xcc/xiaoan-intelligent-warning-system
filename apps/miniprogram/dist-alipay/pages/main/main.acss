page{background:#f4f8f5;color:#173b3a;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif}button::after{border:none}button{margin:0}.app-shell{background:#f4f8f5;min-height:100vh;padding-bottom:118rpx}.page,.phone-page{min-height:calc(100vh - 118rpx)}.page{background:linear-gradient(180deg,rgba(224,244,232,.72),rgba(244,248,245,0) 280rpx),#f4f8f5;padding:26rpx 24rpx 42rpx}.home-page{background:linear-gradient(180deg,#eaf6ee,#f7faf4 440rpx,#f4f7f0),#f4f7f0;padding:0 0 42rpx}.with-top{padding-top:48rpx}.page-header{margin-bottom:22rpx}.body-copy,.field-hint,.field-label,.hero-kicker,.hero-subtitle,.hero-title,.hero-weather text,.home-sos-strip text,.live-row text,.mine-row text,.mine-section > text,.order-meta-line text,.page-header text:first-child,.page-header text:last-child,.profile-card text,.route-card text,.route-note text,.scene-kicker,.scene-status text,.scene-title,.section-head text,.service-pill text,.service-tile text,.staff-top text,.strong-title,.weather-pill text{display:block}.page-header text:first-child{color:#173b3a;font-size:42rpx;font-weight:900;line-height:1.2}.page-header text:last-child{color:#6c817b;font-size:24rpx;line-height:1.48;margin-top:10rpx}.tour-hero{align-items:flex-end;background:radial-gradient(circle at 88% 8%,hsla(0,0%,100%,.28),transparent 150rpx),linear-gradient(145deg,#087f76,#26a988 62%,#f3b957);border-radius:30rpx;box-shadow:0 20rpx 44rpx rgba(17,116,91,.2);color:#fff;display:flex;gap:22rpx;justify-content:space-between;min-height:280rpx;padding:30rpx 28rpx}.hero-copy{flex:1;min-width:0}.hero-kicker{color:hsla(0,0%,100%,.82);font-size:24rpx;font-weight:800}.hero-title{font-size:58rpx;font-weight:900;line-height:1.05;margin-top:12rpx}.hero-subtitle{color:hsla(0,0%,100%,.86);font-size:24rpx;line-height:1.48;margin-top:16rpx;max-width:460rpx}.hero-weather{background:hsla(0,0%,100%,.16);border:1rpx solid hsla(0,0%,100%,.28);border-radius:24rpx;min-width:132rpx;padding:18rpx 14rpx;text-align:center}.hero-weather text:first-child{font-size:38rpx;font-weight:900}.hero-weather text:last-child{color:hsla(0,0%,100%,.82);font-size:20rpx;margin-top:6rpx}.river-scene{background:linear-gradient(180deg,#d6e9e1,#e9f1e9 56%,#f4f7f0);min-height:608rpx;overflow:hidden;padding:34rpx 24rpx 24rpx;position:relative}.river-scene::after{background:#f7f8f3;border-radius:50% 50% 0 0;bottom:-76rpx;content:"";height:170rpx;left:-36rpx;position:absolute;right:-36rpx}.scene-topline{align-items:flex-start;display:flex;gap:20rpx;justify-content:space-between;position:relative;z-index:2}.scene-topline > view:first-child{flex:1;min-width:0}.scene-kicker{color:#487269;font-size:21rpx;font-weight:900;letter-spacing:1rpx}.scene-title{color:#123c39;font-size:48rpx;font-weight:900;line-height:1.12;margin-top:8rpx}.weather-pill{background:hsla(0,0%,100%,.68);border:1rpx solid rgba(54,116,104,.16);border-radius:14rpx;padding:14rpx 10rpx;text-align:center;width:146rpx}.weather-pill text:first-child{color:#123c39;font-size:34rpx;font-weight:900}.weather-pill text:last-child{color:#5d7972;font-size:20rpx;margin-top:4rpx}.river-map{background:#cfe5dc;border:1rpx solid rgba(29,105,98,.12);border-radius:16rpx;box-shadow:0 14rpx 30rpx rgba(37,96,82,.13);height:404rpx;margin-top:24rpx;overflow:hidden;position:relative;z-index:2}.bridge-line,.green-bank,.river-water,.route-dot,.route-label,.route-line,.wave-line{position:absolute}.river-water{background:linear-gradient(160deg,hsla(0,0%,100%,.28),hsla(0,0%,100%,0) 58%),#64adbd;height:184rpx;left:-60rpx;right:-40rpx;top:0;transform:skewY(-8deg);transform-origin:left top}.green-bank{background:linear-gradient(155deg,#edf0d7 0 18%,transparent 18%),linear-gradient(22deg,#9cc98e 0 18%,#bed78f 18% 36%,#e4d59f 36% 47%,#7fb984 47% 100%);bottom:-18rpx;height:286rpx;left:-38rpx;right:-26rpx;transform:rotate(-4deg);transform-origin:center}.route-line{border-top:5rpx dashed hsla(0,0%,100%,.9);height:0;left:94rpx;right:78rpx;top:116rpx;transform:rotate(-8deg)}.wave-l