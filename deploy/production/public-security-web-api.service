[Unit]
Description=Public Security Web FastAPI service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=public-security-web
Group=public-security-web
WorkingDirectory=/opt/public-security-web/project/server
EnvironmentFile=/etc/public-security-web-api.env
Environment=APP_ENV=production
ExecStart=/opt/public-security-web/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
