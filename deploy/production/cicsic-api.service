[Unit]
Description=Yanhuo Shaobing FastAPI service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=cicsic
Group=cicsic
WorkingDirectory=/opt/cicsic/project/server
EnvironmentFile=/etc/cicsic-api.env
Environment=APP_ENV=production
ExecStart=/opt/cicsic/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
